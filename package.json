{
  "name": "@bicou/nuxt-fontawesome",
  "version": "2.0.6",
  "description": "Minimal FontAwesome module for Nuxt 3",
  "author": "Benjamin VIELLARD <bicou@bicou.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/gbicou/nuxt-fontawesome.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/module.mjs"
  },
  "main": "./dist/module.mjs",
  "types": "./dist/module.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "nuxt-module-build prepare",
    "build": "nuxt-module-build build",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "7.3.0",
    "@fortawesome/vue-fontawesome": "3.3.0",
    "@nuxt/kit": "4.4.8"
  },
  "devDependencies": {
    "@fortawesome/free-solid-svg-icons": "7.3.0",
    "@nuxt/devtools": "3.2.4",
    "@nuxt/eslint-config": "1.16.0",
    "@nuxt/module-builder": "1.0.3",
    "@nuxt/schema": "4.4.8",
    "@nuxt/test-utils": "4.0.3",
    "@types/node": "24.13.3",
    "@vue/test-utils": "2.4.11",
    "eslint": "10.5.0",
    "happy-dom": "20.10.6",
    "nuxt": "4.4.8",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.8"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956",
  "publishConfig": {
    "access": "public"
  }
}
